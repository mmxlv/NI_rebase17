<AlienRace.BackstoryDef Name="NI_Backstory_Base" Abstract="True">
	<spawnCategories>
		<li>NI_Backstory</li>
	</spawnCategories>
	
	<!--ここで設定する項目はThingDefs_Races内で設定したよりも上位の権限を持っています。-->
