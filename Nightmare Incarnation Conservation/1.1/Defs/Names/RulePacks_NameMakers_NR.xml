<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--ここでは名前の命名規則を設定しています。-->
<!--命名規則の適用についてはThingDefs_Races内で行っています。-->
<!--特にこだわりが無ければ下記のNRの部分を貴方の設定したRaceの略称辺りにでも変更すると良いでしょう-->
	<RulePackDef>
		<defName>NamerPersonNI</defName><!--ここのdefNameはPawnKindDefs_HumanlikesとThingDefs_Racesフォルダーで主に使用します。-->
		<rulePack>
			<rulesStrings>
				<li>name->[NIFirstname] [NILastname]</li>
			</rulesStrings>
			<rulesRaw>
				<li Class="Rule_File">
					<keyword>NIFirstname</keyword>
					<path>NameGen/NRFirst</path><!--ここでいうPathは翻訳ファイルの英語を使用します。-->
				</li>
				<li Class="Rule_File">
					<keyword>NILastname</keyword>
					<path>NameGen/NRLast</path><!--他のAlienRaceModが一番の参考になるかと思います。-->
				</li>
			</rulesRaw>
		</rulePack>
	</RulePackDef>

</Defs>