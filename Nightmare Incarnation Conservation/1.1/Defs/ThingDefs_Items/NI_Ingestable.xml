<?xml version="1.0" encoding="utf-8" ?>

<Defs>

	<ThingDef>
		<thingClass>ThingWithComps</thingClass>
		<category>Item</category>
		<selectable>true</selectable>
		<altitudeLayer>Item</altitudeLayer>
		<stackLimit>75</stackLimit>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<alwaysHaulable>true</alwaysHaulable>
		<drawGUIOverlay>true</drawGUIOverlay>
		<rotatable>false</rotatable>
		<pathCost>15</pathCost>
		<stuffProps>
			<commonality>0.00</commonality>
		</stuffProps>
		<resourceReadoutPriority>Last</resourceReadoutPriority>
		<tradeability>Sellable</tradeability>
		<defName>NI_ManaherbTea</defName>
		<label>Mana herbal tea</label>
		<description>A magical ore powder boiled with medicinal herbs to extract magical power. A small amount of mana is recovered by taking it.</description>
		<graphicData>
			<texPath>Things/Item/ManaherbTea</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.88</drawSize>
		</graphicData>
		<thingCategories>
			<li>Items</li>
		</thingCategories>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<WorkToMake>400</WorkToMake>
			<MarketValue>10</MarketValue>
			<Mass>0.1</Mass>
			<MaxHitPoints>50</MaxHitPoints>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<ingestible>
			<foodType>Fluid, Processed</foodType>
			<preferability>NeverForNutrition</preferability>
			<maxNumToIngestAtOnce>4</maxNumToIngestAtOnce>
			<baseIngestTicks>240</baseIngestTicks>
			<nurseable>true</nurseable>
			<chairSearchRadius>8</chairSearchRadius>
			<ingestSound>Ingest_Beer</ingestSound>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestHoldUsesTable>false</ingestHoldUsesTable>
			<ingestCommandString>use {0}</ingestCommandString>
			<ingestReportString>taking {0}</ingestReportString>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_OffsetNeed">
					<need>NI_Need_Mana</need>
					<offset>0.5</offset>
				</li>
			</outcomeDoers>
		</ingestible>
		<recipeMaker>
			<researchPrerequisite>PsychoidBrewing</researchPrerequisite>
			<recipeUsers>
				<li>Campfire</li>
				<li>ElectricStove</li>
				<li>FueledStove</li>
			</recipeUsers>
			<workSpeedStat>DrugCookingSpeed</workSpeedStat>
			<workSkill>Cooking</workSkill>
			<skillRequirements>
				<Cooking>2</Cooking>
			</skillRequirements>
		</recipeMaker>
		<costList>
			<LF_MagicCrystal>1</LF_MagicCrystal>
			<MedicineHerbal>1</MedicineHerbal>
		</costList>
	</ThingDef>

