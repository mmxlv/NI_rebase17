<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>NI_NeedMana</defName>
    <workerClass>NightmareIncarnation.ThoughtWorker_NINeedMana</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>魔力が少ない</label>
        <description>魔力がちょっと足りない。</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>魔力不足</label>
        <description>魔力が足りない。</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>魔力欠乏</label>
        <description>魔力が足りなくて集中できない。</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
      <li>
        <label>魔力失調</label>
        <description>自分の体が衰弱していく。早く魔力を補給しなければ。</description>
        <baseMoodEffect>-26</baseMoodEffect>
      </li>
      <li>
        <label>魔力喪失</label>
        <description>もう力が出ない。何でもいいから魔力を摂りたい。</description>
        <baseMoodEffect>-32</baseMoodEffect>
      </li>
      <li>
        <label>魔力飢餓</label>
        <description>何もしなくても顔が青ざめ、脂汗が出てくる。魔力を、早く・・・</description>
        <baseMoodEffect>-38</baseMoodEffect>
      </li>
      <li>
        <label>極度の魔力飢餓</label>
        <description>魔力...魔力を...誰か...</description>
        <baseMoodEffect>-44</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>NI_PolicyUnacceptable</defName>
    <workerClass>NightmareIncarnation.ThoughtWorker_NIPolicyUnacceptable</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>自分に合わない魔力方針</label>
        <description>自分に合わない魔力収集方針を強要されている。必要も無いのに娯楽で人を弄ぶなんて...。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>自分に合わない魔力方針</label>
        <description>自分に合わない魔力収集方針を強要されている。つまみ食いも自由に出来ないなんて！</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>自分に合わない魔力方針</label>
        <description>自分に合わない魔力収集方針を強要されている。自分が食べる相手くらい自分で選ぶ。私に指図しないで！</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>自分に合わない魔力方針</label>
        <description>自分に合わない魔力収集方針を強要されている。限界を超えて人間を弄べないのは何とも味気ない。</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>自分に合わない魔力方針</label>
        <description>自分に合わない魔力収集方針を強要されている。人は散る瞬間こそが最も美しいというのに、何故それを理解できないのか。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>


</Defs>
