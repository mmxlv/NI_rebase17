<Defs>

  <ThingDef ParentName="RockBase">
    <defName>LF_MineableMagicCrystalVein</defName>
    <label>魔晶鉱脈</label>
    <description>魔晶鉱石を含んだ鉱床。</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(110,104,114)</color>
      <colorTwo>(68,65,70)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>5000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>LF_MagicCrystal</mineableThing>
      <mineableYield>5</mineableYield>
      <mineableScatterCommonality>0.06</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>
        <min>2</min>
        <max>5</max>
      </mineableScatterLumpSizeRange>
    </building>
  </ThingDef>

  <ThingDef>
<!--ResourceBaseからの継承項目-->
    <thingClass>ThingWithComps</thingClass>

    <category>Item</category>

    <resourceReadoutPriority>Middle</resourceReadoutPriority>

    <selectable>true</selectable>

    <altitudeLayer>Item</altitudeLayer>

    <stackLimit>75</stackLimit>

    <comps>

      <li Class="CompProperties_Forbiddable"/>

    </comps>

    <alwaysHaulable>true</alwaysHaulable>

    <drawGUIOverlay>true</drawGUIOverlay>

    <rotatable>false</rotatable>

    <pathCost>15</pathCost>

    <stuffProps>
      <commonality>0</commonality>
    </stuffProps>
    <tradeability>Sellable</tradeability>

    <defName>LF_MagicCrystal</defName>
    <label>魔晶鉱石</label>
    <description>透き通った神秘的な輝きを放つ、非常に希少な原石だ。広く知られていないが純度の高いものは魔力を多く含むらしく、魔術の分野においてはさまざまな利用価値があるらしい。</description>
    <graphicData>
      <texPath>Things/Item/Resource/LF_MagicCrystal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <statBases>
      <MarketValue>40</MarketValue>
      <Mass>1</Mass>
      <Beauty>8</Beauty>

