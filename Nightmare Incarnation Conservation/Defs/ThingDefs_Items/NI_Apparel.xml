  <ThingDef ParentName="NI_ApparelMakeableBase">
    <defName>Apparel_NIBabydoll</defName>
    <description>サキュバス用の外套。本来は部屋着として用いられる下着である。</description>
    <label>サキュバスベビードール</label>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Pawn/NI_Succubus/Apparels/Babydoll_Female_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.05</drawSize>
    </graphicData>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>10000</WorkToMake>
      <Mass>1.1</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.85</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2.0</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/NI_Succubus/Apparels/Babydoll</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>NI_Succubus</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65)</only>
        </li>
        <li>
          <weight>30</weight>
          <only>(1,1,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3)</min>
          <max>(0.5,0.5,0.5)</max>
        </li>
        <li>
          <weight>2</weight>
          <min>(0.5,0.5,0.5)</min>
          <max>(1,1,1)</max>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>

	<ThingDef ParentName="NI_ArmorMachineableBase">
    <defName>Apparel_NIBattleGarb</defName>
    <label>ナイトメアバトルガーブ</label>
    <description>サキュバスの戦闘用衣装。装者がサキュバス種族であった場合、あらゆる被ダメージを30%軽減し、さらにスキルの魔力消費量が軽減される。</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>PoweredArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Pawn/NI_Succubus/Apparels/BattleGarb_Female_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <MaxHitPoints>1800</MaxHitPoints>
      <Mass>7.5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.96</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.48</ArmorRating_Blunt>
      <ArmorRating_Heat>0.52</ArmorRating_Heat>
      <Insulation_Cold>40</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <EquipDelay>12</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>0</MoveSpeed>
      <Flammability>-0.8</Flammability>
    </equippedStatOffsets>
    <costList>
      <Cloth>100</Cloth>
      <Gold>2</Gold>
      <LF_MagicCrystal>6</LF_MagicCrystal>

    </costList>
    <apparel>
      <bodyPartGroups>
	<li>Torso</li>
        <li>Neck</li>
	<li>Shoulders</li>
	<li>Arms</li>
	<li>Legs</li>
	<li>Hands</li>
	<li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/NI_Succubus/Apparels/BattleGarb</wornGraphicPath>
      <layers>
	<li>Shell</li>
      </layers>
      <tags>
        <li>NI_SuccubusGreater</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>100</weight>
          <only>(1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>

