<!--バニラのBasePawnを流用する場合に限り場合ここの項目を削除します。-->
<!--バニラのBasePawnに変更することで無改造で民火氏の作った見た目変更Modなどを使用できるかと思います。-->
<!--特別にこの種族だけに変更を加えたい場合(例:この種族だけ乳搾り出来る)は以下の通り独自のDefNameをつけます。-->
<!--”BaseNRPawn”は自分の作るRaceに合わせた略称などに変更すると良いでしょう。-->
<ThingDef Name="BaseNIPawn" Abstract="True">
    <thingClass>Pawn</thingClass>
    <category>Pawn</category>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Pawn</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <hasTooltip>true</hasTooltip>
    <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>
    <inspectorTabs>
		<li>NightmareIncarnation.ITab_ManaPolicy</li>
		<li>ITab_Pawn_Health</li>
		<li>ITab_Pawn_Needs</li>
		<li>ITab_Pawn_Character</li>
		<li>ITab_Pawn_Training</li>
		<li>ITab_Pawn_Gear</li>
		<li>ITab_Pawn_Guest</li>
		<li>ITab_Pawn_Prisoner</li>
		<li>ITab_Pawn_Social</li>
		<li>ITab_Pawn_Log</li>
		<!--民火氏の作った見た目変更Modなどのタブを追加したい場合はこちらとすぐ下のCamps内に追記します。-->
		<!--逆に戦闘ログなどを抜きたい場合は記述を削除すると良いかもしれません。(試したことは無い)-->
    </inspectorTabs>
    <comps>
        <li>
            <compClass>CompAttachBase</compClass>
        </li>
	<li Class="NightmareIncarnation.CompProperties_SuccubusRace" />
    </comps>
    <drawGUIOverlay>true</drawGUIOverlay>
</ThingDef>

<AlienRace.ThingDef_AlienRace ParentName="BaseNIPawn">
    <defName>NI_Race</defName>
	<!--defName内のNewRaceはPawnKindDefs_Humanlikesフォルダ内の設定でも使用します。-->
	<!--defNameはEPOEなどを使用する際は引用します。EPOE側のRecipeDef項内XmlのrecipeUsers内に記述します。(当ModをEPOEの前提Mod化)-->
	<!--または他のユーザーのリリースしているパッチを参考にしてEPOE等の追加手術に適合させます。-->
	<!--1.0追記:すぐ下のhumanRecipeImportがtrueになっている場合はここに書いてあることは特に気にする必要はありません。-->
    <label>サキュバス</label>
	<!--ここがゲーム内の売買いやステータスで表示される種族名です。好きなものに変更しよう。-->
    <description>さきゅばーす！</description>
	<alienRace>
        <generalSettings>
			<maleGenderProbability>0.001</maleGenderProbability>
			<!--男性と女性の比率を弄る記述です。0にしても動作しますがEdbでセーブの際に保存した名前が上手く適用されなくなります。-->
			<!--0.01以下に設定するとEdBに不具合が出てしまう可能性があります。-->
			<!-- <useOnlyPawnkindBackstories>true</useOnlyPawnkindBackstories> -->
			<!--独自のバックストーリーを使用しない際はfalseに変更するか記述ごと削除します。-->
			
			<allowHumanBios>true</allowHumanBios>
			<!--わからん-->
			<humanRecipeImport>true</humanRecipeImport>
			<!--trueにしておくとEPOEやGlitterTech、PolarisBlocなどの手術追加など特に設定しなくても人間と同様の手術を受けられます。-->
			<immuneToXenophobia>false</immuneToXenophobia>
			<!--Humanoid Alien Races本体に付属のTrait、異種族好き/嫌いの影響を受けるか受けないかを決めます。trueで影響を受けます-->
			<notXenophobistTowards>
				<li>Human</li>
			</notXenophobistTowards>
			<!--基本的に人間と同じ種族の場合はHumanに設定することで異種族をみなされなくなります。-->
			
			<!--<forcedRaceTraitEntries>
				<li>
					<defName>NI_ManaAttribute</defName>
					<degree>1</degree>
					<chance>100</chance>
				</li>
            		</forcedRaceTraitEntries>-->
			<!--この項目で性格、特性周りの制御をします。例：種族全員可愛い持ち等。-->
			<!--例ではawnが生成された時にかわいいを10％の確率で付与されるように設定してあります。-->
			<!--聖典(AlienRaceWiki)や他のAlienRaceを参考にするとよいでしょう。-->	
			
			<disallowedTraits>
				<li>Ugly</li>
				<li>Staggeringly ugly</li>
				<li>AnnoyingVoice</li>
				<li>CreepyBreathing</li>
				<li>Undergrounder</li>
				<li>Misandrist</li>
				<li>Misogynist</li>
				<!--特性のDefNameではなくLabelの表示で制御できます。-->
			</disallowedTraits>
			<!--ここでPawnが生成されたときに付与されない特性をリストアップしています。-->
			
			<alienPartGenerator>
			
			
				<headOffset>(0.00, 0.00)</headOffset>
				<!--顔の位置を設定します。左側が左右、右側が上下に相当します。-->
				<!--この項目は頭装備の表示に関わるModの影響を多大に受けます。例:髪の大きさだけが元に戻る、顔の位置が戻るなど-->
				<customDrawSize>(1.10, 1.10)</customDrawSize>
				<customHeadDrawSize>1.00, 1.00)</customHeadDrawSize>
				<customPortraitDrawSize>(1.10, 1.10)</customPortraitDrawSize>
				<customPortraitHeadDrawSize>(1.00, 1.00)</customPortraitHeadDrawSize>
				<!--(横.縦)でグラフィックの比率を変えます。-->
				<!--上手い事調整するとバニラに比べ高身長、頭身の高いキャラを実装できます。-->
				
				<aliencrowntypes>
					<li>Female/Female_NI01face</li>
					<li>Female/Female_NI02face</li>
					<li>Female/Female_NI03face</li>
					<li>Female/Female_NI04face</li>
					<li>Female/Female_NI05face</li>
					<li>Female/Female_NI06face</li>
					<li>Female/Female_NI07face</li>
					<li>Female/Female_NI08face</li>
					<li>Female/Female_NI09face</li>
					<li>Female/Female_NI10face</li>
					<!--<li>追加した頭</li>-->
                </aliencrowntypes>
				<!--独自の頭部グラフィックを使う際は追記します。記述方法さえ合致していれば恐らく幾らでも追加できます。-->
				<!--テクスチャーの命名規則は多少変則なのでこちらも他のAlienRaceModを参考にしながら弄ると良いでしょう。-->
				<!--当方では15個の新規頭を実装して正常に動くことを確認しています。13個を超えるとEdBを使用する際に不具合がでます、使用しなければ問題ありません。-->
		        <alienbodytypes>
					<li>Female</li>
					<!--<li>Fat</li>-->
					<!--<li>Hulk</li>-->
					<!--<li>Male</li>-->
					<!--<li>Thin</li>-->
				</alienbodytypes>
				<!--ゲーム内で生成されるPawnの体型を大まかに制御します。-->
				<!--身体に独自テクスチャーを使用している場合Hulkなど対応するテクスチャーが無いとピンクテクスチャーのエラーが出ますので注意。-->
				<!--身体は女性で性別上は男性と言った特殊なRaceを作る場合は別Def項のBackstory_defで制御します。-->
				
			<useGenderedHeads>false</useGenderedHeads>
			<useGenderedBodies>false</useGenderedBodies>
			<bodyAddons>
				<li>
					<drawSize>1</drawSize>
					<path>Things/Pawn/NI_Succubus/Horns/Horn</path>
					<bodyPart>Horn</bodyPart>
					<inFrontOfBody>true</inFrontOfBody>
					<useSkinColor>false</useSkinColor>
					<drawnInBed>true</drawnInBed>
					<layerOffset>1.9</layerOffset>
					<offsets>
						<south>
							<bodyTypes>
							    <Female>(-0.42,0.54)</Female>
							</bodyTypes>
						</south>
						<north>
							<bodyTypes>
							    <Female>(0,0.89)</Female>
							</bodyTypes>
						</north>
						<east>
							<bodyTypes>
							    <Female>(-0.48,0.58)</Female>
							</bodyTypes>
						</east>
					</offsets>
				</li>
				<li>
					<drawSize>1</drawSize>
					<path>Things/Pawn/NI_Succubus/Bodies/Wing</path>
					<bodyPart>Torso</bodyPart>
					<inFrontOfBody>false</inFrontOfBody>
					<useSkinColor>false</useSkinColor>
					<drawnInBed>false</drawnInBed>
					<layerOffset>-0.9</layerOffset>
					<offsets>
						<south>
							<bodyTypes>
							    <Female>(-0.42,0.22)</Female>
							</bodyTypes>
						</south>
						<north>
							<bodyTypes>
							    <Female>(0,0.56)</Female>
							</bodyTypes>
						</north>
						<east>
							<bodyTypes>
							    <Female>(-0.42,0.22)</Female>
							</bodyTypes>
						</east>
					</offsets>
				</li>
				<li>
					<drawSize>1</drawSize>
					<path>Things/Pawn/NI_Succubus/Tails/Tail</path>
					<bodyPart>Tail</bodyPart>
					<inFrontOfBody>false</inFrontOfBody>
					<useSkinColor>false</useSkinColor>
					<drawnInBed>false</drawnInBed>
					<layerOffset>-1.9</layerOffset>
					<offsets>
						<south>
							<bodyTypes>
							    <Female>(-0.42,0.22)</Female>
							</bodyTypes>
						</south>
						<north>
							<bodyTypes>
							    <Female>(0,0.56)</Female>
							</bodyTypes>
						</north>
						<east>
							<bodyTypes>
							    <Female>(-0.42,0.22)</Female>
							</bodyTypes>
						</east>
					</offsets>
				</li>
			</bodyAddons>
			<!--この項目はこの種族の肌の色を決定します、例では白肌と褐色肌が設定されています。-->
				<alienskincolorgen Class="ColorGenerator_Options">
                    <options>
						<li>
							<weight>10</weight>
							<only>RGBA(1,0.98,0.98,1</only>
						</li>
						<li>
							<weight>2</weight>
							<only>RGBA(0.87,0.69,0.53,1</only>
						</li>
						<!--カンマとピリオドに注意してください。RGB値は独自の調整方法です。Aは透過率らしいですが深く考えるのを止めました。-->
						<!--AlienRaceで生成されるPawnは発色の処理が1段階されていないようです。-->
						<!--そのため大変血色が悪く、何もせずここでいくら肌の色を弄っても生気は出せません。-->
						<!--テクスチャフォルダ内に参考画像を用意してありますので参照をお願いいたします。-->
						<!--特に抵抗がない、そもそも肌色でない場合、特に気にしなくて構いません。-->
                    </options>
                </alienskincolorgen>
				
				<!--この項目ではテクスチャーの特定マスキング部のカラー変更で使用します。-->
				<!--マスキングに使う色指定とどの様に設定するかはテクスチャフォルダを参照ください。-->
				<!--上手く使用することで虹彩の色、上半身、下半身で別の色など再現する事ができます。-->
				<!--バニラのフェイスの瞳の色を変えても何かアレなのでとっとと改造するか記述を削除した方が良いでしょう。-->
				<!--例ではGreenのみです-->
				<alienskinsecondcolorgen Class="ColorGenerator_Options">
					<options>
						<li>
							<weight>100</weight>
							<min>RGBA(1,1,1,1)</min>
							<max>RGBA(1,1,1,1)</max>
						</li>
					</options>
				</alienskinsecondcolorgen>
				
				
				<!--Pawnが生成されたときのヘアカラーなどを任意に制御できます。-->
				<!--この様に記述を削除するなどして適用しない場合は、髪と肌の色などはバニラの人間Pawnと同じ処理になります。-->
				<!--<alienhaircolorgen Class="ColorGenerator_Options">
					<options>
						<li>
						<weight>10</weight>
							<min>RGBA(1,0.82,0.7,1)</min>
							<max>RGBA(1,0.9,0.8,1)</max>
						</li>
					</options>
				</alienhaircolorgen>-->
            </alienPartGenerator>
			

        </generalSettings>
		
		
		<!--テクスチャーのフォルダを指定します。フォルダの階層などに注意してください。他のAlienRaceを参考にするとよいでしょう。-->
		<!--主に独自のテクスチャーを使用する際は上記のように設定しますがバニラの人間Pawnと同じで良ければこの項目を削除します。-->
		<!--その場合表示されるテクスチャーは血色の悪いものになってしまうので注意が必要です。-->
		<graphicPaths>
			<li>
				<head>Things/Pawn/NI_Succubus/Heads/</head>
				<body>Things/Pawn/NI_Succubus/Bodies/</body>
			</li>
		</graphicPaths>
		
		<hairSettings>
		<hasHair>true</hasHair>
                <getsGreyAt>1000</getsGreyAt>
				<!--髪の色が白髪になる年齢ですが、老化の始まる年齢もここの数値の前後で決まります。-->
				
			<hairTags>
				<li>NI_Succubus</li>
				<!--<li>Urban</li>-->
			</hairTags>
			<!---->
			<!--Race独自のヘアスタイルを設定したい場合はHairtagを使います。他のAlienRaceや髪型Modを参考にするとよいでしょう。-->
			<!--この種族のみの髪型を使用したい場合は独自のタグを設定する必要があります。例：NR_hair-->
        </hairSettings>
		
		
		<!--このthoughsettings項ではゲーム内の心情バフなどの効果を無効化したり名前などを種族の設定に合うフレーバーテキストに変更できます。-->
		<!--対応するバニラの心情バフなどを参考に変更すると良いでしょう。-->
		<thoughtSettings>
		<!--無効化する心情バフなどをリストアップします。-->
			<cannotReceiveThoughts>
				<li>ObservedLayingCorpse</li>
				<li>ObservedLayingRottingCorpse</li>
				<li>Incestuous</li>
				<li>Disfigured</li>
				<li>SharedBed</li>
				<li>RebuffedMyRomanceAttempt</li>
				<li>RebuffedMyRomanceAttemptMood</li>
				<li>FailedRomanceAttemptOnMe</li>
				<li>FailedRomanceAttemptOnMeLowOpinionMood</li>
				<li>BrokeUpWithMe</li>
				<li>BrokeUpWithMeMood</li>
				<li>CheatedOnMe</li>
				<li>CheatedOnMeMood</li>
				<li>DivorcedMe</li>
				<li>DivorcedMeMood</li>
				<li>RejectedMyProposal</li>
				<li>RejectedMyProposalMood</li>
				<li>IRejectedTheirProposal</li>
				<li>EnvironmentDark</li>
				<li>Naked</li>
			</cannotReceiveThoughts>
		
		<!--これは心情バフなどのラベルや効果などを独自の定義に置き換えることができます。-->
		<!--例ではパーティを置き換えています。その下はウフフ、アハハです。-->
			<replacerList>
			<!--<li>
				<original>GotSomeLovin</original>
				<replacer>NR_GotSomeLovin</replacer>
				</li>-->
			</replacerList>
        </thoughtSettings>
		
    </alienRace>

	<statBases>
		<MarketValue>2200</MarketValue>
		<MoveSpeed>4.61</MoveSpeed>
		<!--歩く速度です。バニラのヒトは4.61です。-->
		<Mass>60</Mass>
		<Flammability>1</Flammability>
		<ComfyTemperatureMin>0</ComfyTemperatureMin>
		<ComfyTemperatureMax>38</ComfyTemperatureMax>
		<LeatherAmount>0</LeatherAmount>
		<ResearchSpeed>0.9</ResearchSpeed>
		<MiningSpeed>0.9</MiningSpeed>
		<PsychicSensitivity>0.5</PsychicSensitivity>
		<SocialImpact>1.20</SocialImpact>
		<ToxicSensitivity>0.80</ToxicSensitivity>
		<ImmunityGainSpeed>2.0</ImmunityGainSpeed>
		<PainShockThreshold>0.80</PainShockThreshold>
		<MeleeDodgeChance>5</MeleeDodgeChance>
    </statBases>
	<!--基本ステータスを設定できます。装備Mod等の追加効果の記述がそのまま流用出来る物もあります。-->
	<!--当方の追加種族「強化人間」の記述をそのまま引っ張って来たので通常の人間に比べてOPな数値となっています。-->
	
	<tools>
		<li>
			<label>左手</label>
			<capacities>
				<li>Blunt</li>
			</capacities>
			<power>7.5</power>
			<cooldownTime>2</cooldownTime>
			<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
			<surpriseAttack>
				<extraMeleeDamages>
				<li>
					<def>Stun</def>
					<amount>14</amount>
				</li>
				</extraMeleeDamages>
			</surpriseAttack>
		</li>
		<li>
			<label>右手</label>
			<capacities>
				<li>Blunt</li>
			</capacities>
			<power>7.5</power>
			<cooldownTime>2</cooldownTime>
			<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
			<surpriseAttack>
				<extraMeleeDamages>
					<li>
						<def>Stun</def>
						<amount>14</amount>
					</li>
				</extraMeleeDamages>
			</surpriseAttack>
		</li>
		<li>
			<label>頭</label>
			<capacities>
				<li>Blunt</li>
			</capacities>
			<power>7.5</power>
			<cooldownTime>2</cooldownTime>
        		<chanceFactor>0.01</chanceFactor>
			<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
			<surpriseAttack>
				<extraMeleeDamages>
					<li>
						<def>Stun</def>
						<amount>14</amount>
					</li>
				</extraMeleeDamages>
			</surpriseAttack>
		</li>
		<li>
			<label>角</label>
			<capacities>
				<li>Poke</li>
			</capacities>
			<power>7.5</power>
			<cooldownTime>2</cooldownTime>
        		<chanceFactor>0.01</chanceFactor>
			<linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
			<surpriseAttack>
				<extraMeleeDamages>
					<li>
						<def>Stun</def>
						<amount>14</amount>
					</li>
				</extraMeleeDamages>
			</surpriseAttack>
		</li>
    </tools>
	<!--徒手空拳の性能を設定します。手などが特殊形状で武器を持てない種族を設定する場合はこちらの設定を強化すると良いでしょう。-->

	<race>
		<thinkTreeMain>NI_Succubus</thinkTreeMain>
		<thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
		<intelligence>Humanlike</intelligence>
		<makesFootprints>true</makesFootprints>
		<lifeExpectancy>1000</lifeExpectancy>
		<!--寿命です。大体はこの値に達することなくゲームを終えるかと思います。-->
		<nameCategory>HumanStandard</nameCategory>
		<!--<nameGenerator>NamerPersonNI</nameGenerator>
		当Raceで生成されるPawnの命名規則をここで設定します。Namesフォルダの中に命名規則の設定が有ります。-->
		<!--他のAlienRaceModを大変参考になるかと思います。-->
		<!--名前の種類を増やしたい場合はLanguagesフォルダ内の中で設定します。-->
		<body>NI_HumanSuccubus</body>
		<!--種族独自のbody(尻尾や羽など)を設定したい時などは新しく設定した記述が必要です。-->
		<!--このModではHeumanのままにしておくことでEPOEなどを併用する時は新しく設定する必要を省いています-->
		<baseBodySize>1.0</baseBodySize>
		<baseHealthScale>1.0</baseHealthScale>
